<!DOCTYPE html>
<html lang='en'>

<head>
  <meta charset='utf-8' />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <script src='./index.global.js'></script>
  <link rel="stylesheet" href="./styles.css">
  <script>
    document.addEventListener('DOMContentLoaded', function () {

      const eventData = {{ events | safe }};
      const colorPalettes = {{ tags | safe }};

      // Generate Dynamic CSS Styles targeting ALL predefined badges & Inject into <head>
      const styleEl = document.createElement('style');
      let dynamicStyles = `
        .dropdown-item.hidden-item {
          display: none !important;
        }
      `;

      // Loop directly over the configuration keys
      Object.keys(colorPalettes).forEach((tag) => {
        const palette = colorPalettes[tag];
        dynamicStyles += `
          .badge.${tag} {
            background-color: ${palette.bg} !important;
            border: 1px solid ${palette.border} !important;
            color: ${palette.text} !important;
          }
        `;
      });

      styleEl.innerHTML = dynamicStyles;
      document.head.appendChild(styleEl);

      // Define Filter Logic
      function filterEvents() {
        const checkedInputs = Array.from(document.querySelectorAll('.dropdown-item input:checked'));
        const activeTags = checkedInputs.map(el => el.value);
        const definedTags = Object.keys(colorPalettes);

        document.querySelectorAll('.fc-list-event').forEach(row => {
          const appliedTags = definedTags.filter(tag => row.classList.contains(tag));
          let shouldShow = true;

          if (appliedTags.length > 0) {
            shouldShow = appliedTags.some(tag => activeTags.includes(tag));
          }

          if (shouldShow) {
            row.classList.remove('hidden-event');
          } else {
            row.classList.add('hidden-event');
          }
        });

        document.querySelectorAll('.fc-list-day').forEach(dayHeader => {
          let nextEl = dayHeader.nextElementSibling;
          let hasVisibleEvents = false;

          while (nextEl && nextEl.classList.contains('fc-list-event')) {
            if (!nextEl.classList.contains('hidden-event')) {
              hasVisibleEvents = true;
              break;
            }
            nextEl = nextEl.nextElementSibling;
          }

          if (hasVisibleEvents) {
            dayHeader.style.setProperty('display', '', 'important');
          } else {
            dayHeader.style.setProperty('display', 'none', 'important');
          }
        });

        if (calendar && calendar.updateSize) {
          calendar.updateSize();
        }
      }

      window.filterEvents = filterEvents;

      // Generate Filter Dropdown Layout
      const dropdownContainer = document.getElementById('filterDropdown');
      if (dropdownContainer) {
        dropdownContainer.innerHTML = `
          <input type="text" id="calendar-dropdown-search" placeholder="Type to filter..." style="width: calc(100% - 16px); margin: 8px; padding: 6px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; background: #fff; color: #333; font-size: 0.85rem;">
          <div id="calendar-dropdown-items-container"></div>
        `;

        const searchInput = document.getElementById('calendar-dropdown-search');
        const itemsContainer = document.getElementById('calendar-dropdown-items-container');

        searchInput.addEventListener('keyup', () => {
          const filterText = searchInput.value.toLowerCase().trim();
          const items = itemsContainer.querySelectorAll('.dropdown-item');

          items.forEach(item => {
            const badgeText = item.querySelector('.badge').textContent.toLowerCase();
            if (badgeText.includes(filterText)) {
              item.classList.remove('hidden-item');
            } else {
              item.classList.add('hidden-item');
            }
          });
        });

        Object.keys(colorPalettes).forEach(tag => {
          const labelText = tag.toLowerCase();
          const labelEl = document.createElement('label');
          labelEl.className = 'dropdown-item';
          const isChecked = tag === 'all' ? 'checked' : '';
          labelEl.innerHTML = `
            <input type="checkbox" value="${tag}" ${isChecked}>
            <span class="badge ${tag}">${labelText}</span>
          `;
          labelEl.querySelector('input').addEventListener('change', filterEvents);
          itemsContainer.appendChild(labelEl);
        });
      }

      const targetOrigin = window.location.hostname === 'localhost'
        ? window.location.origin
        : 'https://www.marcelldls.lol';

      // Initialize FullCalendar
      var calendarEl = document.getElementById('calendar');
      var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'listMonth',
        height: '100%',
        contentHeight: 'auto',
        aspectRatio: 1.3,
        headerToolbar: {
          left: 'prev,next',
          center: 'title',
          right: 'todayButton,externalLink'
        },
        customButtons: {
          todayButton: {
            text: '↓',
            hint: 'Today',
            click: function () {
              calendar.today();
            }
          },
          externalLink: {
            text: '⧉',
            hint: 'Fullscreen',
            click: function () {
              window.top.location.href = 'https://calender.marcelldls.lol';
            }
          }
        },
        eventClassNames: function (arg) {
          return arg.event.classNames || [];
        },
        eventContent: function (arg) {
          const titleText = arg.event.title;
          const classes = arg.event.classNames || [];

          const titleEl = document.createElement('span');
          titleEl.classList.add('fc-list-event-title-text');
          titleEl.innerText = titleText;

          const wrapEl = document.createElement('div');
          wrapEl.style.display = 'inline-block';
          wrapEl.appendChild(titleEl);

          if (classes.length > 0) {
            const tagsContainer = document.createElement('span');
            tagsContainer.classList.add('fc-tags-container');

            classes.forEach(cls => {
              const label = cls.toLowerCase();
              const badge = document.createElement('span');
              badge.className = `badge ${cls}`;
              badge.innerText = label;
              tagsContainer.appendChild(badge);
            });
            wrapEl.appendChild(tagsContainer);
          }

          return { domNodes: [wrapEl] };
        },
        eventClick: function (info) {
          // Re-mapped to standard extended properties context definition matching eventData structure
          const targetLink = info.event.extendedProps.link || info.event.url;
          if (targetLink) {
            info.jsEvent.preventDefault();
            window.open(targetLink, '_blank');
          }
        },
        events: eventData
      });

      calendar.on('datesSet', function () {
        setTimeout(filterEvents, 0);
      });

      calendar.render();

      const footerContainer = document.createElement('div');
      footerContainer.className = 'custom-calendar-footer';
      footerContainer.style.textAlign = 'center';
      footerContainer.style.padding = '0.625em 0';
      footerContainer.style.fontSize = '1rem';
      footerContainer.innerText = 'Build: {{ build_date }}';

      calendarEl.appendChild(footerContainer);

      // Toggle Dropdown Window Setup
      window.toggleDropdown = function (event) {
        event.stopPropagation();
        if (dropdownContainer) {
          dropdownContainer.classList.toggle('show');

          // Automatically clear input text and focus search field when opened
          if (dropdownContainer.classList.contains('show')) {
            const searchInput = document.getElementById('calendar-dropdown-search');
            const itemsContainer = document.getElementById('calendar-dropdown-items-container');
            if (searchInput && itemsContainer) {
              searchInput.value = '';
              itemsContainer.querySelectorAll('.dropdown-item').forEach(i => i.classList.remove('hidden-item'));
            }
          }
        }
      };

      document.addEventListener('click', function (event) {
        const container = document.querySelector('.dropdown-container');
        if (dropdownContainer && (!container || !container.contains(event.target))) {
          dropdownContainer.classList.remove('show');
        }
      });

      // Generate message payload
      const parsedTagsPayload = Object.keys(colorPalettes).map((tag) => {
        const palette = colorPalettes[tag];
        return {
          id: tag,
          // Keep it simple: use the key directly in lowercase
          label: tag.toLowerCase(),
          styles: `background-color: ${palette.bg}; border: 1px solid ${palette.border}; color: ${palette.text};`
        };
      });

      window.addEventListener('message', function (event) {
        if (event.data && event.data.type === 'PARENT_READY') {
          window.parent.postMessage({
            type: 'CALENDAR_RENDERED_TAGS',
            payload: parsedTagsPayload
          }, targetOrigin);
        }
      });
    });

  </script>
</head>

<body>
  <div class="filter-wrapper">
    <div class="dropdown-container">
      <button class="dropdown-btn" onclick="toggleDropdown(event)">
        <span>Filter by Tags</span>
        <span class="dropdown-arrow">▼</span>
      </button>
      <div class="dropdown-content" id="filterDropdown"></div>
    </div>
  </div>

  <div id="calendar"></div>
</body>

</html>
